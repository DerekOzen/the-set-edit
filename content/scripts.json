entListener(\"click\", function (e) { var el = e.target.closest(\"[data-track]\"); if (!el) { var a = e.target.closest(\"a[href^='tel:']\"); if (a) memTrack(\"call_click\", { element: a.getAttribute(\"href\") }); return; }\n    var t = el.getAttribute(\"data-track\"); if (t === \"cta\") memTrack(\"cta_click\", { element: el.getAttribute(\"data-name\") || el.textContent.trim().slice(0, 40) });\n    if (t === \"brief-step\") memTrack(el.getAttribute(\"data-step\") === \"1\" ? \"brief_started\" : \"form_step\", { step_name: \"brief-\" + el.getAttribute(\"data-step\") });\n    if (t === \"apply-step\") memTrack(el.getAttribute(\"data-step\") === \"1\" ? \"application_started\" : \"form_step\", { step_name: \"apply-\" + el.getAttribute(\"data-step\") }); });\n  document.addEventListener(\"focusin\", function (e) { var f = e.target.closest(\"[data-form]\"); if (f && e.target.name && !e.target.__memf) { e.target.__memf = 1; memTrack(\"field_focus\", { element: e.target.name, step_name: f.getAttribute(\"data-form\") }); } });\n  document.addEventListener(\"visibilitychange\", function () { if (document.visibilityState === \"hidden\") memTrack(\"exit\", { max_scroll: s90 ? 90 : s50 ? 50 : 0 }); });\n  // expose attribution for the form: copy these into hidden fields on submit\n  window.memAttribution = function () { return { visitor_id: v.visitor_id, session_id: s.session_id, first_touch: v.first_touch, first_click: v.first_click, last_touch: s.last_touch, click: s.click, site: SITE, landing_page: s.landing_page, device: s.device, time_on_site_s: Math.round((Date.now() - new Date(s.started_at).getTime()) / 1000) }; };\n})();\n</script>\n",
