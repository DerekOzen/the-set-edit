ute(\"data-site\") || location.hostname.replace(/^www\\./, \"\");\n  var now = function () { return new Date().toISOString(); };\n  var uuid = function () { return ([1e7]+-1e3+-4e3+-8e3+-1e11).replace(/[018]/g, function (c) { return (c ^ crypto.getRandomValues(new Uint8Array(1))[0] & 15 >> c / 4).toString(16); }); };\n  var q = {}; location.search.replace(/^\\?/, \"\").split(\"&\").forEach(function (p) { if (!p) return; var kv = p.split(\"=\"); q[decodeURIComponent(kv[0])] = decodeURIComponent((kv[1] || \"\").replace(/\\+/g, \" \")); });\n  var clickId = q.gclid ? [\"gclid\", q.gclid] : q.fbclid ? [\"fbclid\", q.fbclid] : q.ttclid ? [\"ttclid\", q.ttclid] : q.msclkid ? [\"msclkid\", q.msclkid] : null;\n  // referrer classification when no UTMs\n  function classify() {\n    if (q.utm_source) return { source: q.utm_source, medium: q.utm_medium || \"\", campaign: q.utm_campaign || \"\", content: q.utm_content || \"\", term: q.utm_term || \"\" };\n    if (clickId) { var m = { gclid: [\"google\",\"cpc\"], fbclid: [\"meta\",\"paid_social\"], ttclid: [\"tiktok\",\"paid_social\"], msclkid: [\"bing\",\"cpc\"] }[clickId[0]]; return { source: m[0], medium: m[1], campaign: \"(clickid only)\", content: \"\", term: \"\" }; }\n    var r = document.referrer ? document.referrer.replace(/^https?:\\/\\//, \"\").split(\"/\")[0] : \"\";\n    if (!r || r.indexOf(location.hostname) > -1) return { source: \"(direct)\", medium: \"(none)\", campaign: \"\", content: \"\", term: \"\" };\n    if (/google\\./.test(r)) return { source: \"google\", medium: \"organic\", campaign: \"\", content: \"\", term: \"\" };\n    if (/instagram|facebook|fb\\.|tiktok|threads/.test(r)) return { source: r.replace(/^l\\./, \"\"), medium: \"organic_social\", campaign: \"\", content: \"\", term: \"\" };\n    if (/chatgpt|openai/.test(r)) return { source: \"chatgpt\", medium: \"referral\", campaign: \"\", content: \"\", term: \"\" };\n    return { source: r, medium: \"referral\", campaign: \"\", content: \"\", term: